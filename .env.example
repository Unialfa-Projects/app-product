# Variáveis usadas pelo docker-compose.yml (copie para .env e ajuste).
# Senha do PostgreSQL. Só vale na criação do volume: depois de criado,
# trocar aqui exige recriar o volume (docker compose down -v).
POSTGRES_PASSWORD=produtos_dev
# Portas publicadas no computador
POSTGRES_PORT=5434
API_PORT=3001
FRONTEND_PORT=8080
# Chaves de API do backend. GESTOR_API_KEY também é embutida no frontend no build.
GESTOR_API_KEY=gestor_dev_trocar
OPERADOR_API_KEY=operador_dev_trocar
# Sites que podem chamar a API pelo navegador (separados por vírgula)
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

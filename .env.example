# Variáveis opcionais para o docker-compose.yml da raiz (todas têm default).
# Copie para ".env" apenas se quiser sobrescrever alguma porta ou origem.

POSTGRES_PORT_HOST=5433
BACKEND_PORT_HOST=3000
FRONTEND_PORT_HOST=8080

# Usado pelo Nginx/Fastify (CORS) — deve refletir a URL pública do frontend.
FRONTEND_ORIGEM=http://localhost:8080

# Embutido no build do frontend (Vite) — deve refletir a URL pública do backend.
VITE_API_BASE_URL=http://localhost:3000

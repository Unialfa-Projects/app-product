# Endereço da API. Vazio = mesma origem (o Vite/nginx repassa /api ao backend).
VITE_API_URL=
# Chave enviada em "Authorization: Bearer ..." (GESTOR_API_KEY ou OPERADOR_API_KEY do backend).
# Com a chave de operador não é possível alterar preço, inativar/reativar nem ver o histórico.
VITE_API_KEY=gestor_dev_trocar
